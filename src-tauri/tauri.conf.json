{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metaplasia",
  "version": "0.1.4",
  "identifier": "dev.metaplasia.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Metaplasia",
        "width": 1500,
        "height": 860,
        "minWidth": 1120,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "theme": "Dark",
        "decorations": true,
        "backgroundColor": "#000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
